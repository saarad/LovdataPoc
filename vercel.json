{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm --prefix LovdataPocApi/ClientApp ci",
  "buildCommand": "npm --prefix LovdataPocApi/ClientApp run build",
  "outputDirectory": "LovdataPocApi/ClientApp/dist",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/backend-proxy?target=/api/:path*"
    },
    {
      "source": "/openapi/:path*",
      "destination": "/api/backend-proxy?target=/openapi/:path*"
    },
    {
      "source": "/((?!api(?:/|$)|openapi(?:/|$)).*)",
      "destination": "/index.html"
    }
  ]
}
